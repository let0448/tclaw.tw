---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- if p.sitemap == false -%}{% continue %}{%- endif -%}
  {%- if p.url contains ".xml" or p.url contains ".txt" or p.url contains "404" or p.url contains "/assets/" -%}{% continue %}{%- endif -%}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% if p.url == "/" %}<changefreq>monthly</changefreq><priority>1.0</priority>
    {% elsif p.url contains "articles" %}<changefreq>weekly</changefreq><priority>0.9</priority>
    {% else %}<changefreq>yearly</changefreq><priority>0.5</priority>{% endif %}
  </url>
{%- endfor -%}
{%- for post in site.posts -%}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{% if post.last_modified %}{{ post.last_modified | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
{%- endfor %}
</urlset>
